{
  "name": "contente-web",
  "productName": "ContentE Web",
  "version": "1.0.0",
  "description": "Editor de Metadados Estruturais e Empacotador de Objetos Digitais (Ephemera / Arquivo)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "pt.contente.web",
    "productName": "ContentE Web",
    "files": [
      "index.html",
      "src/**/*",
      "vendor/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    }
  }
}
